{
  "name": "change-note",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "node scripts/third-party-notices.mjs && tsc --noEmit && vite build && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "test:licenses": "node --test tests/third-party-notices.test.mjs",
    "test:signing": "node --test tests/signing-config.test.mjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "start": "SERVE_CLIENT=1 tsx server/index.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "desktop:pack": "npm run build:desktop && electron-builder --mac dir --arm64",
    "desktop:dist": "npm run build:desktop && electron-builder --mac dmg --arm64",
    "desktop:dist:signed": "npm run build:desktop && electron-builder --config electron-builder.signed.cjs --mac dmg --arm64",
    "desktop:notarize": "node scripts/notarize-desktop.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.7",
    "fflate": "^0.8.2",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "desktop/main.cjs",
  "description": "Web画面の修正案を作成し、変更前と比較できるアプリ",
  "build": {
    "appId": "jp.changenote.desktop",
    "productName": "ScreenDraft",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/*.cjs",
      "dist-desktop/**",
      "dist/client/**",
      "public/**",
      "fixtures/*.html",
      "LICENSE",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-extension",
        "to": "dist-extension"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "ScreenDraft ${version}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NaokiOouchi",
        "repo": "ScreenDraft",
        "releaseType": "release"
      }
    ]
  },
  "license": "AGPL-3.0-only"
}
